<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="projMenuGeneral.frmMenuGeneral"
        Title="Menu General"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu x:Name="msGeneral" DockPanel.Dock="Top">
      <MenuItem x:Name="msOperaciones" Header="Operaciones">
          <MenuItem x:Name="msSuma" Header="Suma" Click="msSuma_Click" />
          <MenuItem x:Name="msResta" Header="Resta" Click="msResta_Click" />
          <MenuItem x:Name="msMultiplicacion" Header="Multiplicacion" Click="msMultiplicacion_Click" />
          <MenuItem x:Name="msDivision" Header="Division" Click="msDivision_Click" />
      </MenuItem>
      <MenuItem x:Name="msFiguras" Header="Figuras" />
      <MenuItem x:Name="msEscolar" Header="Escolar">
          <MenuItem x:Name="msAlumnos" Header="Alumnos" Click="msAlumnos_Click" />
          <MenuItem x:Name="msMaestros" Header="Maestros" Click="msMaestros_Click" />
          <MenuItem x:Name="msMaterias" Header="Materias" Click="msMaterias_Click" />
          <MenuItem x:Name="msCarreras" Header="Carreras" Click="msCarreras_Click" />
          <MenuItem x:Name="msDepartamentos" Header="Departamentos" Click="msDepartamentos_Click" />
          <MenuItem x:Name="msSemestres" Header="Semestres" Click="msSemestres_Click" />
          <MenuItem x:Name="msUnidades" Header="Unidades Academicas" Click="msUnidades_Click" />
          <MenuItem x:Name="msTurnos" Header="Turnos" Click="msTurnos_Click" />
      </MenuItem>
      <!-- Solo admin -->
      <MenuItem x:Name="msUbicaciones" Header="Ubicaciones">
          <MenuItem x:Name="msEstados" Header="Estados" Click="msEstados_Click" />
          <MenuItem x:Name="msMunicipios" Header="Municipios" Click="msMunicipios_Click" />
          <MenuItem x:Name="msCiudades" Header="Ciudades" Click="msCiudades_Click" />
      </MenuItem>
      <MenuItem x:Name="msSolicitudes" Header="Solicitudes" Click="msSolicitudes_Click" />
      <MenuItem x:Name="msSalir" Header="Salir" Click="msSalir_Click" />
    </Menu>
    <Panel>
      <!-- Solo usuario: abre la ventana para solicitar un lugar nuevo -->
      <Button x:Name="btnSolicitar" Content="Solicitar nuevo lugar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Click="btnSolicitar_Click" />
    </Panel>
  </DockPanel>
</Window>
