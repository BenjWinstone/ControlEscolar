<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ControlEscolar.Views"
        x:Class="ControlEscolar.Views.AlumnosWindow"
        Title="Alumnos"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel>
    <views:BarraAcciones x:Name="Barra" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          Margin="16" RowSpacing="10" ColumnSpacing="12">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Matricula" VerticalAlignment="Center" />
      <TextBox x:Name="txtMatricula" Grid.Row="0" Grid.Column="1" MaxLength="9" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre" VerticalAlignment="Center" />
      <TextBox x:Name="txtNombre" Grid.Row="1" Grid.Column="1" MaxLength="100" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Correo" VerticalAlignment="Center" />
      <TextBox x:Name="txtCorreo" Grid.Row="2" Grid.Column="1" MaxLength="100" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Telefono" VerticalAlignment="Center" />
      <TextBox x:Name="txtTelefono" Grid.Row="3" Grid.Column="1" MaxLength="10" />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Carrera" VerticalAlignment="Center" />
      <ComboBox x:Name="comboCarreras" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" />
    </Grid>
  </StackPanel>
</Window>
