<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ControlEscolar.Views"
        x:Class="ControlEscolar.Views.MateriasWindow"
        Title="Materias"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel>
    <views:BarraAcciones x:Name="Barra" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
          Margin="16" RowSpacing="10" ColumnSpacing="12">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Clave de la Materia" VerticalAlignment="Center" />
      <TextBox x:Name="txtClave" Grid.Row="0" Grid.Column="1" MaxLength="9" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre de la Materia" VerticalAlignment="Center" />
      <TextBox x:Name="txtNombre" Grid.Row="1" Grid.Column="1" MaxLength="100" />
    </Grid>
  </StackPanel>
</Window>
