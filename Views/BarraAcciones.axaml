<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ControlEscolar.Views.BarraAcciones">
  <StackPanel>
    <Menu>
      <MenuItem Header="_Opciones">
        <MenuItem Header="_Registrar" Click="Registrar_Click" />
        <MenuItem Header="_Buscar" Click="Buscar_Click" />
        <MenuItem Header="_Eliminar" Click="Eliminar_Click" />
        <Separator />
        <MenuItem Header="_Salir" Click="Salir_Click" />
      </MenuItem>
    </Menu>
    <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,6,6,0">
      <Button Click="Registrar_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="avares://ControlEscolar/Assets/Iconos/save.png" Width="16" Height="16" />
          <TextBlock Text="Registrar" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Click="Buscar_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="avares://ControlEscolar/Assets/Iconos/search.png" Width="16" Height="16" />
          <TextBlock Text="Buscar" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Click="Eliminar_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="avares://ControlEscolar/Assets/Iconos/trash.png" Width="16" Height="16" />
          <TextBlock Text="Eliminar" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>
