<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Como en tu proyecto original: sin "nullable" y con los using escritos a mano en cada archivo -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>projMenuGeneral</RootNamespace>
    <AssemblyName>projMenuGeneral</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versiones flotantes: al restaurar toman el ultimo parche de cada linea -->
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los iconos de la carpeta Iconos pasan a ser recursos del programa -->
    <AvaloniaResource Include="Iconos\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Escolar\frmTurnos.axaml.cs">
      <DependentUpon>frmTurnos.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
