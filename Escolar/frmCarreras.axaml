<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="projMenuGeneral.Escolar.frmCarreras"
        Title="Carreras"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- Las posiciones (Canvas.Left / Canvas.Top) son las mismas X, Y que tenias en el diseñador de WinForms -->
    <Canvas>
      <TextBlock x:Name="labelClave" Text="Clave de la Carrera" Canvas.Left="200" Canvas.Top="100" />
      <TextBox x:Name="txtClave" Canvas.Left="330" Canvas.Top="95" Width="241" />
      <TextBlock x:Name="labelNombre" Text="Nombre de la Carrera" Canvas.Left="200" Canvas.Top="125" />
      <TextBox x:Name="txtNombre" Canvas.Left="330" Canvas.Top="120" Width="241" />
      <TextBlock x:Name="labelDepartamento" Text="Departamento" Canvas.Left="200" Canvas.Top="150" />
      <ComboBox x:Name="comboDepartamento" Canvas.Left="330" Canvas.Top="145" Width="241" />
    </Canvas>

    <!-- Menu y barra de iconos (van encima, arriba) -->
    <StackPanel VerticalAlignment="Top">
      <Menu x:Name="msCarreras">
        <MenuItem x:Name="msOpcionesCarrera" Header="Opciones">
          <MenuItem x:Name="msRegistrarCarrera" Header="Registrar" Click="msRegistrarCarrera_Click" />
          <MenuItem x:Name="msBuscarCarrera" Header="Buscar" Click="msBuscarCarrera_Click" />
          <MenuItem x:Name="msEliminarCarrera" Header="Eliminar" Click="msEliminarCarrera_Click" />
        </MenuItem>
        <MenuItem x:Name="msSalir" Header="Salir" Click="msSalir_Click" />
      </Menu>
      <StackPanel x:Name="tsCarreras" Classes="toolstrip" Orientation="Horizontal" Height="50" Spacing="2">
        <Button x:Name="tsRegistrarCarrera" Click="tsRegistrarCarrera_Click" Background="Transparent" Padding="8,7" ToolTip.Tip="Registrar">
          <Image Source="avares://projMenuGeneral/Iconos/save.png" Width="32" Height="32" />
        </Button>
        <Button x:Name="tsBuscarCarrera" Click="tsBuscarCarrera_Click" Background="Transparent" Padding="8,7" ToolTip.Tip="Buscar">
          <Image Source="avares://projMenuGeneral/Iconos/search.png" Width="32" Height="32" />
        </Button>
        <Button x:Name="tsEliminarCarrera" Click="tsEliminarCarrera_Click" Background="Transparent" Padding="8,7" ToolTip.Tip="Eliminar">
          <Image Source="avares://projMenuGeneral/Iconos/trash.png" Width="32" Height="32" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Panel>
</Window>
