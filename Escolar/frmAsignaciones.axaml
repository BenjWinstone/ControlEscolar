<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="projMenuGeneral.Escolar.frmAsignaciones"
        Title="Asignacion de Materias"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- Estandar: primer TextBox/ComboBox en Top=90, primer label en Top=95, 30 de separacion entre filas.
         Labels en Left=195 (Width 160), controles en Left=365 (Width 241): centrado para ventana de 800 -->
    <Canvas>
      <TextBlock x:Name="labelClave" Text="Clave de la Asignacion" Canvas.Left="195" Canvas.Top="95" Width="160" />
      <TextBox x:Name="txtClave" Canvas.Left="365" Canvas.Top="90" Width="241" />
      <TextBlock x:Name="labelMaestro" Text="Maestro" Canvas.Left="195" Canvas.Top="125" Width="160" />
      <ComboBox x:Name="comboMaestros" Canvas.Left="365" Canvas.Top="120" Width="241" />
      <TextBlock x:Name="labelMateria" Text="Materia" Canvas.Left="195" Canvas.Top="155" Width="160" />
      <ComboBox x:Name="comboMaterias" Canvas.Left="365" Canvas.Top="150" Width="241" />
      <TextBlock x:Name="labelGrupo" Text="Grupo" Canvas.Left="195" Canvas.Top="185" Width="160" />
      <TextBox x:Name="txtGrupo" Canvas.Left="365" Canvas.Top="180" Width="241" MaxLength="10" />
      <TextBlock x:Name="labelSalon" Text="Salon" Canvas.Left="195" Canvas.Top="215" Width="160" />
      <TextBox x:Name="txtSalon" Canvas.Left="365" Canvas.Top="210" Width="241" MaxLength="10" />
      <TextBlock x:Name="labelFechaInicio" Text="Fecha de Inicio" Canvas.Left="195" Canvas.Top="245" Width="160" />
      <CalendarDatePicker x:Name="dateInicio" Canvas.Left="365" Canvas.Top="240" Width="241" Height="24" MinHeight="24" Padding="4,2" VerticalContentAlignment="Center" />
      <TextBlock x:Name="labelFechaFin" Text="Fecha de Fin" Canvas.Left="195" Canvas.Top="275" Width="160" />
      <CalendarDatePicker x:Name="dateFin" Canvas.Left="365" Canvas.Top="270" Width="241" Height="24" MinHeight="24" Padding="4,2" VerticalContentAlignment="Center" />
      <TextBlock x:Name="labelEstado" Text="Estado" Canvas.Left="195" Canvas.Top="305" Width="160" />
      <ComboBox x:Name="comboEstado" Canvas.Left="365" Canvas.Top="300" Width="241" />
    </Canvas>

    <!-- Menu y barra de iconos (van encima, arriba) -->
    <StackPanel VerticalAlignment="Top">
      <Menu x:Name="msAsignaciones">
        <MenuItem x:Name="msOpciones" Header="Opciones">
          <MenuItem x:Name="msRegistrar" Header="Registrar" Click="msRegistrar_Click" />
          <MenuItem x:Name="msBuscar" Header="Buscar" Click="msBuscar_Click" />
          <MenuItem x:Name="msEliminar" Header="Eliminar" Click="msEliminar_Click" />
        </MenuItem>
        <MenuItem x:Name="msSalir" Header="Salir" Click="msSalir_Click" />
      </Menu>
      <StackPanel x:Name="tsAsignaciones" Classes="toolstrip" Orientation="Horizontal" Height="50" Spacing="2">
        <Button x:Name="tsRegistrar" Click="tsRegistrar_Click" Background="Transparent" Padding="8,7" ToolTip.Tip="Registrar">
          <Image Source="avares://projMenuGeneral/Iconos/save.png" Width="32" Height="32" />
        </Button>
        <Button x:Name="tsBuscar" Click="tsBuscar_Click" Background="Transparent" Padding="8,7" ToolTip.Tip="Buscar">
          <Image Source="avares://projMenuGeneral/Iconos/search.png" Width="32" Height="32" />
        </Button>
        <Button x:Name="tsEliminar" Click="tsEliminar_Click" Background="Transparent" Padding="8,7" ToolTip.Tip="Eliminar">
          <Image Source="avares://projMenuGeneral/Iconos/trash.png" Width="32" Height="32" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Panel>
</Window>
