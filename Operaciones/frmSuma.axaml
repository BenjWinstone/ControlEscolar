<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="projMenuGeneral.Operaciones.frmSuma"
        Title="Suma"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <Canvas>
      <TextBlock x:Name="labelValor1" Text="Valor 1" Canvas.Left="195" Canvas.Top="95" Width="160" />
      <TextBox x:Name="txtValor1" Canvas.Left="365" Canvas.Top="90" Width="241" />
      <TextBlock x:Name="labelValor2" Text="Valor 2" Canvas.Left="195" Canvas.Top="125" Width="160" />
      <TextBox x:Name="txtValor2" Canvas.Left="365" Canvas.Top="120" Width="241" />
      <Button x:Name="button1" Content="Sumar" Canvas.Left="363" Canvas.Top="171" Width="75" Height="23" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
    </Canvas>
  </Panel>
</Window>
