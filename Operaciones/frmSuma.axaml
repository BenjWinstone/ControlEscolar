<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="projMenuGeneral.Operaciones.frmSuma"
        Title="Suma"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- Las posiciones (Canvas.Left / Canvas.Top) son las mismas X, Y que tenias en el diseñador de WinForms -->
    <Canvas>
      <TextBlock x:Name="labelValor1" Text="Valor 1" Canvas.Left="304" Canvas.Top="74" />
      <TextBox x:Name="txtValor1" Canvas.Left="350" Canvas.Top="71" Width="100" />
      <TextBlock x:Name="labelValor2" Text="Valor 2" Canvas.Left="304" Canvas.Top="114" />
      <TextBox x:Name="txtValor2" Canvas.Left="350" Canvas.Top="111" Width="100" />
      <Button x:Name="button1" Content="Sumar" Canvas.Left="337" Canvas.Top="162" Width="75" Height="23" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
    </Canvas>
  </Panel>
</Window>
